{
  "name": "dsh-theme-mbcc",
  "version": "0.1.0",
  "description": "Unofficial black and crimson urban archive theme for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "ANOSAKI",
  "repository": {
    "type": "git",
    "url": "https://github.com/anosaki258-dot/deepseek-harness-mbcc-theme.git"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/fonts/OFL.txt",
    "assets/fonts/FONT-NOTICE.md",
    "assets/fonts/font-manifest.json",
    "docs",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/audit-package.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "mbcc",
    "path-to-nowhere"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "linkedom": "^0.18.14"
  }
}
